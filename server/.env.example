PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# PostgreSQL — adjust to your local setup
# Example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartservice
DATABASE_URL=

# JWT — generate a real secret in production
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5